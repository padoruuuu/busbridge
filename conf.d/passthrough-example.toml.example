# Minimal "zero mapping" config: no [[method]], [[signal]], [[property]],
# or introspection_xml at all. Every D-Bus call on this name gets forwarded
# to the Varlink backend automatically as "{interface}.{member}", and every
# Varlink push received on the listen socket gets emitted as a D-Bus
# signal the same way. See config/schema.rs's `passthrough` doc comment
# for exactly what "automatically" means and its trade-offs (generic JSON
# arg names, inferred D-Bus types rather than declared ones, no
# Properties Get/Set/GetAll support).
#
# The two things nothing can guess for you and that you still have to
# provide - a D-Bus name to own, and where the Varlink backend actually
# lives - are the `name` and `backend` lines below.

[service]
bus = "session"
name = "org.example.MyPassthroughService"
object_path = "/org/example/MyPassthroughService"
passthrough = true

[varlink]
# Inbound: backends/apps connect here to push events -> D-Bus signals.
listen = "unix:/run/user/1000/busbridge/my-service-push.sock"
# Outbound: D-Bus calls get forwarded here as Varlink calls.
backend = "unix:/run/user/1000/my-varlink-backend.sock"
